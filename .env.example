# Ecom environment template — copy to .env (gitignored) and fill per environment.
# Story 1.1 scaffold: no real values are required to build, typecheck, lint, test,
# or smoke. DATABASE_URL is consumed by Prisma CLI (migrate/db) only; the Worker/API
# use the @prisma/adapter-pg driver at runtime once a database exists.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecom?schema=public

# API / Worker process configuration
PORT=3100
NODE_ENV=development