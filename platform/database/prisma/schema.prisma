// Ecom platform database schema — Story 1.1 baseline.
// AC(1) forbids business tables and speculative domain entities, so this file
// contains ONLY the datasource and the client generator (zero `model` blocks).
// One owner-named schema file per module arrives in later stories (AD-2 / AD-25).
//
// Prisma 7 removed the datasource `url` from schema files: connection URLs for
// Migrate live in `prisma.config.ts`, and the runtime `PrismaClient` is built
// with the `@prisma/adapter-pg` driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}