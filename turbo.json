{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "architecture:check": {
      "cache": false,
      "outputs": []
    },
    "contracts:check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
